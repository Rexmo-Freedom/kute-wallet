# Keys the app reads from .env (see README). Values here are placeholders.

# Kute backend
BACKEND=xxx
# Public web base the share-link claim pages live on (https://<host>/c/{id}).
# Defaults to BACKEND; the host must match the applinks entitlement and the
# Android App Link intent filter.
PUBLIC_WEB_BASE=xxx

# Crisp chat
CRISP_ID=xxx

# App Store (numeric id, used by rating links and AppsFlyer on iOS)
APP_STORE_ID=xxx

# Breez (Lightning / Spark)
BREEZ_API_KEY=xxx

# Flashnet rewards (dollar balance earnings)

# PostHog (POSTHOG_PROJECT_TOKEN preferred; POSTHOG_API_KEY is the fallback)
POSTHOG_PROJECT_TOKEN=xxx
POSTHOG_API_KEY=xxx

# Hyperliquid: set to true for testnet builds
HYPERLIQUID_TESTNET=false

# Branta (payee names and logos on Send): no key needed. Set to true to
# point a test build at Branta's staging registry (its sample codes).
BRANTA_STAGING=false
