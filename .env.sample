# Keys the app reads from .env (see README). Values here are placeholders.

# Kute backend
BACKEND=xxx

# Crisp chat
CRISP_ID=xxx

# App Store (numeric id, used by rating links and AppsFlyer on iOS)
APP_STORE_ID=xxx

# Breez (Lightning / Spark)
BREEZ_API_KEY=xxx

# Flashnet rewards (dollar balance earnings)

# PostHog (POSTHOG_PROJECT_TOKEN preferred; POSTHOG_API_KEY is the fallback)
POSTHOG_PROJECT_TOKEN=xxx
POSTHOG_API_KEY=xxx

# AppsFlyer (per-platform keys override the shared one)
APPSFLYER_DEV_KEY=xxx
APPSFLYER_DEV_KEY_IOS=
APPSFLYER_DEV_KEY_ANDROID=
APPSFLYER_ONELINK_TEMPLATE=xxx

# Hyperliquid: set to true for testnet builds
HYPERLIQUID_TESTNET=false
